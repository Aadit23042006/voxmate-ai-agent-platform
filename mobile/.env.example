# ============================================================
# VOXMATE MOBILE — ENVIRONMENT TEMPLATE
# Expo / React Native
# Safe to commit to GitHub
# ============================================================


# ============================================================
# BACKEND API URL
# ============================================================

# ------------------------------------------------------------
# Local development — same computer
# ------------------------------------------------------------
# Expo Web / local development:
EXPO_PUBLIC_API_URL=http://localhost:8000


# ------------------------------------------------------------
# Android Emulator
# ------------------------------------------------------------
# Android Emulator reaches the host computer through 10.0.2.2.
#
# To use the Android Emulator, change to:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000


# ------------------------------------------------------------
# Physical Android / iOS device
# ------------------------------------------------------------
# Replace <YOUR-LAN-IP> with the LAN IP address of the computer
# running the VoxMate FastAPI backend.
#
# Example:
# EXPO_PUBLIC_API_URL=http://<YOUR-LAN-IP>:8000
#
# Example with a real LAN IP format:
# EXPO_PUBLIC_API_URL=http://192.168.1.25:8000


# ============================================================
# SECURITY
# ============================================================

# IMPORTANT:
# Do NOT put secrets in EXPO_PUBLIC_* variables.
#
# Expo public environment variables are intended for values that
# may be exposed to the client application.
#
# Never place the following in this file:
# - API keys
# - JWT secrets
# - database passwords
# - Redis credentials
# - OAuth client secrets
# - GitHub tokens
# - Firebase private keys
# - service-account credentials
# - encryption keys
# - access tokens
#
# Backend secrets must remain in the backend/server environment.