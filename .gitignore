# ============================================================
# VOXMATE TASK 6 — ROOT GITIGNORE
# Python Backend | FastAPI | Docker | Expo / React Native
# Production / Company-Ready Security Configuration
# ============================================================


# ============================================================
# ENVIRONMENT & SECRETS
# ============================================================

# Ignore real environment files everywhere
**/.env
**/.env.*

# IMPORTANT:
# Environment templates are intentionally allowed.
# These rules MUST appear after the broad .env rules.
!/.env.example
!**/.env.example


# ============================================================
# SERVICE ACCOUNTS / FIREBASE / GOOGLE CREDENTIALS
# ============================================================

**/*service-account*.json
**/*firebase-adminsdk*.json
**/google-services.json
**/*private-key*.json

**/secrets/

**/*.pem
**/*.key
**/*.p12
**/*.pfx


# ============================================================
# PYTHON
# ============================================================

__pycache__/
**/__pycache__/

*.py[cod]
*$py.class

venv/
.venv/
.venv_*/
env/
ENV/

build/
dist/
*.egg-info/
.eggs/
wheels/


