# ============================================================
# VOXMATE — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
#
# PURPOSE:
#   Safe environment-variable template for local development,
#   Docker Compose, testing, and production deployment.
#
# SETUP:
#   Copy this file to .env and replace placeholder values
#   with your local/private configuration.
#
# SECURITY:
#   NEVER commit .env.
#   NEVER place real API keys, OAuth secrets, JWT secrets,
#   database passwords, access tokens, or encryption keys
#   in this file.
#
# PRODUCTION:
#   Production platforms such as Render should provide these
#   values through environment variables / secret management.
#
# ============================================================


# ============================================================
# DATABASE — POSTGRESQL
# ============================================================

POSTGRES_USER=voxmate

POSTGRES_PASSWORD=replace_with_a_long_random_password

POSTGRES_DB=voxmate

# Docker Compose service name is "postgres".
# For Docker Compose, use the service hostname "postgres".
#
# For local development outside Docker, replace the hostname
# with your local PostgreSQL host if required.
DATABASE_URL=postgresql+psycopg2://voxmate:replace_with_a_long_random_password@postgres:5432/voxmate


# ============================================================
# CACHE / MESSAGE BROKER — REDIS
# ============================================================

# Docker Compose service name is "redis".
REDIS_URL=redis://redis:6379/0


# ============================================================
# AUTHENTICATION / JWT
# ============================================================

# Replace with a strong random secret of at least 32 characters.
# DO NOT use this placeholder as a real production secret.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

JWT_ALGORITHM=HS256

JWT_EXPIRE_MINUTES=60


# ============================================================
# GOOGLE GEMINI AI
# ============================================================

# Add the real API key only to your local .env or
# production secret manager.
GEMINI_API_KEY=

# Keep these model names aligned with the models supported
# by your configured Gemini API/account.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

GEMINI_EMBEDDING_MODEL=gemini-embedding-2


# ============================================================
# APPLICATION CONFIGURATION
# ============================================================

# Local-development default.
# Production deployment should override this with:
# ENV=production
ENV=development

LOG_LEVEL=INFO

# Comma-separated list of tools requiring explicit user approval.
VOXMATE_CONFIRM_TOOLS=create_reminder,run_code


# ============================================================
# GOOGLE CALENDAR / GMAIL OAUTH
# ============================================================

# Optional until Google OAuth is configured.

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

# Local-development callback.
# Production MUST override this with the registered
# production OAuth callback URL.
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback

# Local-development public application URL.
# Production MUST override this with the public HTTPS URL.
PUBLIC_BASE_URL=http://localhost:8000


# ============================================================
# CORS
# ============================================================

# Comma-separated list of allowed frontend origins.
#
# Local development:
#   http://localhost:8000
#   http://127.0.0.1:8000
#
# Production MUST be replaced with the actual trusted
# frontend origin(s). Do NOT use "*".
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000


# ============================================================
# EXPO PUSH NOTIFICATIONS
# ============================================================

# Optional for managed Expo push service.
# Add the real token only to .env or production secret manager.
EXPO_ACCESS_TOKEN=


# ============================================================
# GITHUB CODING AGENT / OAUTH
# ============================================================

# Generate a secure Fernet-compatible encryption key.
# Leave blank until GitHub token encryption is configured.
GITHUB_TOKEN_ENCRYPTION_KEY=

GITHUB_CLIENT_ID=

GITHUB_CLIENT_SECRET=

# Local-development callback.
# Production MUST override this with the registered
# production OAuth callback URL.
GITHUB_REDIRECT_URI=http://localhost:8000/integrations/github/callback


# ============================================================
# END OF VOXMATE ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================